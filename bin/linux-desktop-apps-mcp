@mcp.tool()
def gui_take_screenshot(save_path: str = "/tmp/ag_screen.png") -> str:
    """
    Take a fast (~77ms) full-desktop screenshot on Pop!_OS COSMIC Wayland without /tmp clutter.
    """
    try:
        out = _ag().take_screenshot(save_path)
        if os.path.exists(out):
            return f"Screenshot successfully saved to {out}"
    except Exception as e:
        return f"Failed to take screenshot: {e}"
    return "Failed to take screenshot."


