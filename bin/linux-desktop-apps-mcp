    """
    Scroll mouse wheel up (positive amount, e.g. 5) or down (negative amount, e.g. -5)
    natively across Wayland & Xwayland. Optionally move pointer to (x, y) first.
    """
    ok = _ag().scroll(amount, x=x, y=y, persistent=True)
    if ok:
        return f"Scrolled mouse wheel by {amount} units."
    return "Scroll failed."


@mcp.tool()
def gui_get_screen_size() -> str:
    """Get screen resolution as 'width, height' (e.g. '1366, 768')."""
    w, h = _ag().get_screen_resolution()
    return f"{w}, {h}"


@mcp.tool()
def gui_get_mouse_position() -> str:
    """Get current (x, y) coordinates of the mouse cursor (tracked UInput or Xwayland fallback)."""
    ag = _ag()
    ptr = ag._POINTER_SINGLETON
    if ptr is not None and ptr._last_pos is not None:
        return f"({ptr._last_pos[0]}, {ptr._last_pos[1]})"
    pag = ag._get_pyautogui()
    if pag:
        try:
            x, y = pag.position()
            return f"({x}, {y})"
        except Exception:
            pass
    return "Unknown mouse position"


@mcp.tool()
def gui_smart_click(target: str, window: Optional[str] = None, button: str = "left", double: bool = False) -> str:
    """
    Smart click on any screen element by text label (tries AT-SPI first, then fast Smart OCR)
    or by coordinates (e.g. '500, 300' or '(500, 300)') with closed-loop visual delta verification.
    """
    ag = _ag()
    m = re.match(r"^\(?\s*(\d+)\s*[,x\s]\s*(\d+)\s*\)?$", target.strip())
    if m:
        cx, cy = int(m.group(1)), int(m.group(2))
        data = ag.click_verify(cx, cy, button=button, double=double, persistent=True)
        return (
            f"Clicked coordinates ({cx}, {cy}). "
            f"Delta: {data.get('delta_percent', 0)}%, State changed: {data.get('state_changed', False)}"
        )

    ok = ag.click_element(target, window=window, button=button, double=double, ocr_fallback=True, persistent=True)
    if ok:
        return f"Successfully smart-clicked '{target}'."
    return f"Failed to click '{target}': Element/Text not found"


@mcp.tool()
def gui_inspect_window(window_title: Optional[str] = None) -> dict:
    """
    Inspect an open application window: focuses it, crops screenshot to its exact bounds,
    and returns both AT-SPI widgets and line-grouped OCR UI labels with center coordinates.
    """
    try:
        return _ag().inspect_window(window_title, persistent=True)
    except Exception as e:
        return {"error": f"Failed to inspect window: {e}"}


@mcp.tool()
def gui_visual_grid_inspect(window_title: Optional[str] = None) -> str:
    """
    Captures the target application window (or active window) and overlays a high-contrast
    alphanumeric coordinate grid (A1..Z10) at ~23 KB for icon-only or canvas apps.
    """
    ag = _ag()
    crop_path = "/tmp/ag_grid_crop.png"
    grid_path = "/tmp/ag_visual_grid.png"
    try:
        ag.screenshot_window(window_title, save_path=crop_path)
        ag.overlay_grid(crop_path, output_path=grid_path)
        return f"Annotated visual grid saved to {grid_path}. Size: {os.path.getsize(grid_path)} bytes."
    except Exception as e:
        return f"Failed to generate visual grid: {e}"


@mcp.tool()
def gui_drag_and_drop(start_x: int, start_y: int, end_x: int, end_y: int, duration: float = 0.5) -> str:
    """Perform smooth Wayland + Xwayland mouse drag-and-drop between two coordinates."""
    ok = _ag().drag(start_x, start_y, end_x, end_y, duration=duration, persistent=True)
    if ok:
        return f"Successfully dragged from ({start_x}, {start_y}) to ({end_x}, {end_y})."
    return "Failed to drag."


@mcp.tool()
def gui_wait_for(text: Optional[str] = None, window_title: Optional[str] = None, timeout: int = 10) -> bool:
    """
    Deterministically wait for an application window, visual change, or specific text to appear
    using fast pixel-diff gating before running OCR.
    """
    ag = _ag()
    if text:
        found, _ = ag.wait_for_text(text, timeout=float(timeout), window=window_title)
        return found

    if window_title:
        start = time.time()
        while time.time() - start < timeout:
            if ag.find_windows(window_title):
                return True
            time.sleep(0.35)
        return False

    changed, _ = ag.wait_for_change(timeout=float(timeout))
    return changed


@mcp.tool()
def gui_som_inspect(window_title: Optional[str] = None) -> dict:
    """
    Set-of-Mark (SoM) visual inspector: draws numbered badges [1], [2], ... onto the
    window screenshot (/tmp/ag_som.png) and returns exact ID->coordinate mappings so you
    can click any element cleanly with gui_click_mark(id).
    """
    try:
        return _ag().som_inspect(window_title, persistent=True)
    except Exception as e:
        return {"error": f"SoM inspection failed: {e}"}


@mcp.tool()
def gui_click_mark(mark_id: int, button: str = "left", double: bool = False) -> str:
    """
    Click a Set-of-Mark element ID ([1], [2], ...) previously mapped by gui_som_inspect().
    """
    ok = _ag().click_mark(mark_id, button=button, double=double, persistent=True)
    if ok:
        return f"Clicked SoM mark [{mark_id}]."
    return f"Failed to click SoM mark [{mark_id}]."


@mcp.tool()
def gui_click_icon(
    template_path: str,
    window_title: Optional[str] = None,
    threshold: float = 0.82,
    button: str = "left",
    double: bool = False,
) -> str:
    """
    Locate a textless toolbar/app icon using OpenCV multi-scale template matching and click its center.
    """
    ok = _ag().click_icon(
        template_path,
        window=window_title,
        threshold=threshold,
        button=button,
        double=double,
        persistent=True,
    )
    if ok:
        return f"Clicked icon matching '{template_path}'."
    return f"Failed to find or click icon '{template_path}'."


@mcp.tool()
def gui_batch(
    steps: List[Dict[str, Any]],
    guard_window: Optional[str] = None,
    stop_on_popup: bool = False,
) -> dict:
    """
    Execute a multi-step GUI macro sequence in ONE call with zero round-trip latency.
    Supports: 'focus', 'maximize', 'click', 'click_element', 'click_text', 'click_mark',
    'click_icon', 'replace_text', 'drag', 'scroll', 'type', 'key', 'hotkey', 'wait',
    'wait_text', 'wait_change', 'screenshot', 'copy_image'.
    Optional guard_window enables Focus Guard (aborts before typing/clicking if focus left target window).
    Optional stop_on_popup halts immediately if an unexpected modal dialog appears.
    """
    return _ag().run_batch(steps, persistent=True, guard_window=guard_window, stop_on_popup=stop_on_popup)


@mcp.tool()
def gui_copy_image_to_clipboard(image_path: str) -> str:
    """
    Copy a local image file into the Wayland system clipboard as 'image/png' with zero hang.
    """
    ok, msg = _ag().copy_image_to_clipboard(image_path)
    return msg if ok else f"Failed to copy image to clipboard: {msg}"


@mcp.tool()
def gui_get_display_info() -> str:
    """Get native display resolution, refresh rate, and active scale factor from cosmic-randr."""
    return _ag().get_display_info()


if __name__ == "__main__":
    mcp.run()
