{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UDBEDecisionPayload",
  "description": "Strict schema for UDBE Decision Engine evaluation payload (v3.7 Defensive Edition)",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "pillars"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3,
      "description": "Title or subject of the decision dilemma"
    },
    "pole_alpha": {
      "type": "string",
      "description": "Positive / Proceed / Accept pole option (defaults to YES)"
    },
    "pole_beta": {
      "type": "string",
      "description": "Negative / Reject / Abort pole option (defaults to NO)"
    },
    "context": {
      "type": "string",
      "description": "Background facts, situation description, or constraints"
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit assumptions made during evaluation"
    },
    "pre_mortem": {
      "description": "Cognitive pre-mortem analysis (string or structured object)",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alpha_worst_case": { "type": "string" },
            "beta_worst_case": { "type": "string" },
            "preventative_mitigations": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    "tripwires": {
      "description": "Kill-criteria and empirical tripwires (string or structured array)",
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trigger", "action"],
            "properties": {
              "trigger": { "type": "string" },
              "action": { "type": "string" },
              "review_date": { "type": "string" }
            }
          }
        }
      ]
    },
    "downside_floor": {
      "description": "Antifragile downside floor (string or structured object)",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_tolerable_loss": { "type": "string" },
            "reversible": { "type": "boolean" },
            "survival_guaranteed": { "type": "boolean" }
          }
        }
      ]
    },
    "pillars": {
      "type": "array",
      "minItems": 1,
      "description": "List of evaluation pillars (unconstrained reality dimensions)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "weight"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Descriptive name of the pillar (in Bengali, English, etc.)"
          },
          "pillar_type": {
            "type": "string",
            "enum": [
              "fiduciary",
              "legal",
              "financial",
              "technical",
              "emotional",
              "operational",
              "reputational",
              "strategic",
              "other"
            ],
            "description": "Semantic type of the pillar for language-agnostic veto enforcement"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Importance weight of the pillar (strictly > 0)"
          },
          "alpha_match": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Score/Probability supporting Pole Alpha (0-100)"
          },
          "score_alpha": { "type": "number", "minimum": 0, "maximum": 100 },
          "alpha_percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "alpha": { "type": "number", "minimum": 0, "maximum": 100 },
          "beta_risk": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Risk/Probability supporting Pole Beta (0-100)"
          },
          "score_beta": { "type": "number", "minimum": 0, "maximum": 100 },
          "beta_percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "beta": { "type": "number", "minimum": 0, "maximum": 100 },
          "contract_signed": {
            "type": "boolean",
            "description": "Whether an enforceable written legal/fiduciary contract is signed"
          },
          "no_contract": {
            "type": "boolean",
            "description": "Explicit confirmation that no contract exists"
          },
          "deal_breaker": {
            "type": "boolean",
            "description": "Whether this pillar constitutes a non-negotiable deal-breaker"
          },
          "veto": {
            "type": "boolean",
            "description": "Manual or explicit veto flag"
          },
          "veto_reason": {
            "type": "string",
            "description": "Explanation of why a fatal veto was triggered"
          },
          "fatal_condition": {
            "type": "string",
            "description": "Definition of what constitutes an existential failure in this pillar"
          },
          "rationale": {
            "type": "string",
            "description": "Detailed reasoning behind the assigned scores"
          },
          "evidence": {
            "description": "Empirical evidence supporting the pillar",
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "evidence_verified": {
            "type": "boolean",
            "description": "Whether the cited evidence has been independently audited"
          },
          "unevidenced": {
            "type": "boolean",
            "description": "Flag indicating optimistic claims lack verified evidence"
          },
          "requires_proof": {
            "type": "boolean",
            "description": "Flag indicating proof is mandatory before accepting high alpha"
          },
          "confidence_range": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": { "type": "number", "minimum": 0, "maximum": 100 },
              "max": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        }
      }
    }
  }
}
